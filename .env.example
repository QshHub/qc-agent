# ==========================================================================
# QC-Agent 环境配置
# 说明：本文件不应提交到版本库（见 .gitignore）
# ==========================================================================

# ---------- 大模型（Agent 判定与报告生成）----------
# DeepSeek 平台 API Key（必填）
DEEPSEEK_API_KEY=

# 模型名：deepseek-flash 支持图片输入，deepseek-v4-pro 能力更强
QC_MODEL=deepseek-flash

# ---------- 检测后端（YOLO OBB）----------
# 已训练完成的模型（yolo11m-obb.pt 微调，100 轮）
#   mAP50=0.757  mAP50-95=0.488  P=0.728  R=0.811（ultralytics 官方 val）
#   自建评测：P=0.630 R=0.685 F1=0.656，正常图误检 0/13
# ⚠️ 训练好的权重不入库（体积 40MB+，且与数据集绑定），请填你本机的绝对路径。
#    获取方式见 README「模型权重与数据集」；没有权重时系统会降级到像素后端。
QC_YOLO_WEIGHTS=/path/to/your/best.pt

# 置信度阈值。0.25 在官方 val 下 P=0.728/R=0.811，是精度/召回的平衡点
QC_YOLO_CONF=0.25

# 推理尺寸必须与训练一致（本次训练用 640）
QC_YOLO_IMGSZ=640

# 推理设备：0 = GPU0（已确认 CUDA 可用）
QC_YOLO_DEVICE=0

# ---------------- 检测指标基线（用于回归对比）----------------
# 更换模型后跑 qc_detect_eval.py 与此对比，避免性能回退
#   Precision 0.630 / Recall 0.685 / F1 0.656
#   面积误差中位 15.41% / 长边误差中位 10.41%
#   正常图误检 0/13（0%）
#   已知短板：端面裂纹召回 35.2%（88 实例）、端面缺口 64.5%（31 实例）
#   改进方向：提高 imgsz 到 1024（配合 qc_prepare_dataset.py 生成 1600px 数据集）

# ---------- GSD 标定（像素 → 物理尺寸）----------
# ⚠️ 尚未标定！样品在图中约 2752 px 宽。
# 在标定之前，physical_metrics_reliable=false，判定应使用相对化指标：
#   total_area_ratio_of_image（缺陷面积/图像面积）
#   len_ratio_of_diag（缺陷长边/图像对角线）
QC_GSD_MM_PER_PX=0.0545
# 标定完成后设为 1，表示物理量可信
QC_GSD_CALIBRATED=0

# ---------- 检测后端选择 ----------
# auto  = 优先 YOLO，不可用时降级像素后端
# yolo  = 强制 YOLO（失败即报错）
# pixel = 强制像素后端（对照基线）
QC_BACKEND=auto

# ---------- 服务与会话 ----------
QC_MAX_SESSIONS=50

# 检查点数据库（LangGraph 断点续检用）
QC_CHECKPOINT_DB=
