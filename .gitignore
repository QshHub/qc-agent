# ============================================================================
# 工业质检多模态 Agent 系统 — .gitignore
#
# 原则：
#   1. 任何含密钥/凭证的文件绝不入库
#   2. 可再生的派生数据不入库（数据库、缓存、评测输出、合成样本）
#   3. 大体积二进制不入库（模型权重、wheel 包）
#   4. IDE / 缓存 / 备份目录不入库
# ============================================================================

# ---------- 密钥与本地配置（最高优先级）----------
# .env 含 DEEPSEEK_API_KEY。一旦提交，历史里永久可查，推送到远端即等于泄露。
# 需要模板时用 .env.example（不含真实密钥）。
.env
.env.local
.env.*.local
!.env.example

# ---------- Python 缓存与虚拟环境 ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.lgenv/
*.egg-info/
dist/
build/

# ---------- IDE ----------
.idea/
.vscode/
*.iml
*.swp
*~

# ---------- 运行时数据（可再生）----------
# SQLite 数据库：含测试期间产生的报告与复核记录，属于本机运行态数据
data/*.db
data/*.db-shm
data/*.db-wal

# 评测输出：每次运行都会重新生成
data/eval_*.json
data/detect_val*.json

# 逐份报告的 JSON 快照
data/reports/

# 合成测试图：qc_eval.ensure_samples() 会自动生成
data/samples/

# 样品区域缓存：键为绝对路径，换机器即失效，由 qc_gsd_calib.py 重新生成
data/sample_regions.json

# ---------- 大体积二进制 ----------
# 模型权重：另行分发或从训练产物获取，不入 git
weights/
*.pt
*.onnx
*.engine
*.pth

# 离线安装包
*.whl
data/wheels/
wheels/

# ---------- 同步备份 ----------
# qc_sync_files.py 覆盖前生成的旧版本备份
_backup_*/

# ---------- 第三方库源码（不可入库）----------
# agentscope/ 是 AgentScope 的完整 git clone（自带 .git，1644 个文件 / 21.4 MB），
# 以 editable 模式安装在本机。若入库，git 会把它当成「未声明的子模块」记录成
# 一个悬空引用，别人 clone 后得到空目录，且仓库里会出现别人的整个源码树。
# 正确做法：依赖由 requirements.txt 声明，本地用 pip 安装。
agentscope/
# 其他可能被误 clone 进来的第三方库源码
langgraph/
langchain*/
pydantic/
fastapi/
uvicorn/

# ---------- 训练产物 ----------
runs/
*.log

# ---------- 系统文件 ----------
.DS_Store
Thumbs.db
desktop.ini

# ============================================================================
# 保留说明：以下文件虽在 data/ 下但**应当入库**
#   （当前无此需求；若将来有基准数据集需要版本化，在此加 ! 例外）
# ============================================================================
